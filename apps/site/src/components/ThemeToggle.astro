---
// Light / dark / system, with system as the default until someone chooses.
// The choice lives in localStorage, which is per-browser and never leaves it —
// there is no account here to attach a preference to.
//
// One icon that cycles, not three labelled buttons: the control is the least
// important thing in the masthead and had been the loudest. The icon shows the
// state that is in force, so the current mode is readable without a label.
---

<button class="theme" type="button" data-theme-mode="system" title="Motyw" aria-label="Motyw">
  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
    <g data-icon="light" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
      <circle cx="8" cy="8" r="3.1" />
      <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.1 1.1M11.85 11.85l1.1 1.1M3.05 12.95l1.1-1.1M11.85 4.15l1.1-1.1" />
    </g>
    <g data-icon="dark">
      <path
        d="M13.1 9.7A5.6 5.6 0 0 1 6.3 2.9 5.6 5.6 0 1 0 13.1 9.7Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linejoin="round"
      />
    </g>
    <g data-icon="system">
      <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.3" />
      <path d="M8 2.5a5.5 5.5 0 0 1 0 11Z" fill="currentColor" />
    </g>
  </svg>
</button>

<script is:inline>
  (() => {
    const KEY = 'ebner-theme';
    const ORDER = ['system', 'light', 'dark'];
    const LABEL = { system: 'jak w systemie', light: 'jasny', dark: 'ciemny' };

    const root = document.documentElement;
    const button = document.querySelector('.theme');
    if (!button) return;

    const read = () => {
      try {
        const stored = localStorage.getItem(KEY);
        return ORDER.includes(stored) ? stored : 'system';
      } catch {
        // Private windows and blocked site data both throw here. A theme is a
        // convenience; losing it must not take the page with it.
        return 'system';
      }
    };

    const apply = (value) => {
      if (value === 'light' || value === 'dark') root.dataset.theme = value;
      else delete root.dataset.theme;
      button.dataset.themeMode = value;
      // The title says what is on now; the accessible name says that too,
      // because a button whose name never changes reads as a dead control.
      button.title = 'Motyw: ' + LABEL[value];
      button.setAttribute('aria-label', 'Motyw: ' + LABEL[value] + ' — zmień');
    };

    apply(read());

    button.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(button.dataset.themeMode) + 1) % ORDER.length];
      try {
        if (next === 'system') localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, next);
      } catch {}
      apply(next);
    });
  })();
</script>

<style>
  .theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid transparent;
    background: none;
    color: var(--ls);
    cursor: pointer;
    transition: color 120ms, border-color 120ms;
  }

  .theme:hover,
  .theme:focus-visible {
    color: var(--fg);
    border-color: var(--wl);
  }

  /* Exactly one of the three sits in the same 16px box. */
  .theme svg > g {
    display: none;
  }

  .theme[data-theme-mode='light'] g[data-icon='light'],
  .theme[data-theme-mode='dark'] g[data-icon='dark'],
  .theme[data-theme-mode='system'] g[data-icon='system'] {
    display: inline;
  }
</style>
