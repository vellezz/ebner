---
import { ClientRouter } from 'astro:transitions';
import AppPanel from '../components/AppPanel.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Dziennik roboczy Ebnera Gripe.' } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d3d0c8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1917" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Ebner" />

    {/* Before first paint, or a dark-mode visitor gets a white flash. */}
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const t = localStorage.getItem('ebner-theme');
            if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
            else delete document.documentElement.dataset.theme;
          } catch {}
        };
        apply();
        // A swap replaces the document, and the chosen theme lives on its root
        // element. `astro:after-swap` runs before the new page is painted, so
        // reapplying here means the flash never happens rather than happening
        // briefly. This listener is registered once, in the head, on purpose.
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    {/*
      The ground colour, inline, because the script above only decides which
      one — the values live in tokens.css, which is a separate request, and
      until it arrives the browser paints its own white. On a phone that gap is
      long enough to see, and it is what the flash on reload was.

      These four colours are duplicated from tokens.css on purpose: by
      definition they cannot come from the file whose arrival they cover. They
      are --bg and --fg for each scheme and nothing else; everything that can
      wait, waits.
    */}
    <style is:inline>
      :root {
        color-scheme: light;
        --boot-bg: #d3d0c8;
        --boot-fg: #1e1d1a;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          color-scheme: dark;
          --boot-bg: #1a1917;
          --boot-fg: #e6e4dd;
        }
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
        --boot-bg: #1a1917;
        --boot-fg: #e6e4dd;
      }
      html {
        background: var(--boot-bg);
      }
      body {
        margin: 0;
        background: var(--boot-bg);
        color: var(--boot-fg);
      }
    </style>
    {/*
      Client-side navigation, which is here for a reason that is not polish.
      In an installed app every link click was a full document load, and
      Android repaints the ground behind its own navigation bar each time —
      the buttons at the bottom of the phone flickered on every move. Nothing
      added to a reloading page fixes that; the page has to stop reloading.

      The transition it brings is the second reason, and it is why the swipe
      can now move in the direction of the gesture.
    */}
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;1,400&family=Archivo+Narrow:wght@500;600;700&family=DM+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        <a href="/" class="mark">ebner.gripe</a>
        <nav class="nav readout">
          <a href="/dni">Dni</a>
          <a href="/sprawy">Sprawy</a>
          <a href="/mapa">Mapa</a>
          <a href="/szukaj">Szukaj</a>
        </nav>
        <div class="ident">
          <span class="readout stamp">Ebner Gripe &middot; usługi ogólne &middot; jedn. Hanna</span>
          <ThemeToggle />
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="footer">
        <span class="readout">Dziennik roboczy</span>
        <AppPanel />
      </footer>
    </div>

    <script is:inline>
      // Registered after load so it never competes with rendering the entry,
      // which is the only thing anyone came for.
      //
      // Installed apps are the reason for everything below the registration.
      // A browser tab navigates, and navigating is when the browser looks for
      // a new service worker; an installed app gets opened and resumed, and
      // can sit on one version indefinitely. So the app asks on every resume,
      // and reloads itself when a new worker takes over.
      // Once per document, not once per page: with client-side navigation the
      // document outlives every page in it.
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js')
            .then((registration) => {
              const check = () => {
                if (document.visibilityState === 'visible') {
                  registration.update().catch(() => {});
                }
              };
              document.addEventListener('visibilitychange', check);
              check();
            })
            .catch(() => {});

          // A page that had no controller gets one the first time a worker
          // claims it. That is an installation, not an update, and reloading
          // for it would reload every first visit.
          const hadController = Boolean(navigator.serviceWorker.controller);
          let pending = false;
          let reloading = false;
          const apply = () => {
            if (!pending || reloading) return;
            reloading = true;
            location.reload();
          };

          navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (!hadController) return;
            pending = true;
            // Never mid-sentence. A new version is not worth yanking the page
            // out from under someone reading it, and network-first fetching
            // means what they are reading is already current.
            if (document.visibilityState === 'hidden') apply();
          });
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden') apply();
          });
        });
      }
    </script>
  </body>
</html>

<style>
  .shell {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 28px 0 20px;
    border-bottom: 1px solid var(--ln);
  }

  .mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .nav {
    display: flex;
    gap: 18px;
    margin-right: auto;
    padding-left: 8px;
  }

  .nav a {
    color: var(--f2);
  }

  .ident {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Label tape, not a stamp — the design's own device for identity marks. */
  .stamp {
    background: var(--ts);
    color: var(--tf);
    padding: 4px 10px;
    font-size: 11px;
  }

  main {
    flex: 1;
    padding: 40px 0 72px;
  }

  .footer {
    border-top: 1px solid var(--sp);
    padding: 20px 0 32px;
    color: var(--ls);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-start;
    justify-content: space-between;
  }
</style>
