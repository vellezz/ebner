---
import AppPanel from '../components/AppPanel.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Dziennik roboczy Ebnera Gripe.' } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d3d0c8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1917" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Ebner" />

    {/* Before first paint, or a dark-mode visitor gets a white flash. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('ebner-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;1,400&family=Archivo+Narrow:wght@500;600;700&family=DM+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        <a href="/" class="mark">ebner.gripe</a>
        <nav class="nav readout">
          <a href="/dni">Dni</a>
          <a href="/sprawy">Sprawy</a>
        </nav>
        <div class="ident">
          <span class="readout stamp">Ebner Gripe &middot; usługi ogólne &middot; jedn. Hanna</span>
          <ThemeToggle />
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="footer">
        <span class="readout">Dziennik roboczy</span>
        <AppPanel />
      </footer>
    </div>

    <script is:inline>
      // Registered after load so it never competes with rendering the entry,
      // which is the only thing anyone came for.
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>

<style>
  .shell {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 28px 0 20px;
    border-bottom: 1px solid var(--ln);
  }

  .mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .nav {
    display: flex;
    gap: 18px;
    margin-right: auto;
    padding-left: 8px;
  }

  .nav a {
    color: var(--f2);
  }

  .ident {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Label tape, not a stamp — the design's own device for identity marks. */
  .stamp {
    background: var(--ts);
    color: var(--tf);
    padding: 4px 10px;
    font-size: 11px;
  }

  main {
    flex: 1;
    padding: 40px 0 72px;
  }

  .footer {
    border-top: 1px solid var(--sp);
    padding: 20px 0 32px;
    color: var(--ls);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-start;
    justify-content: space-between;
  }
</style>
