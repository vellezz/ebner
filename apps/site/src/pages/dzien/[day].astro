---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import Verdict from '../../components/Verdict.astro';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  const byDay = [...entries].sort((a, b) => a.data.day - b.data.day);

  // Neighbours are the adjacent *entries*, not day ± 1 — days are not
  // consecutive, so arithmetic on the day number would point at nothing.
  return byDay.map((entry, i) => ({
    params: { day: String(entry.data.day) },
    props: {
      entry,
      previous: byDay[i - 1] ?? null,
      next: byDay[i + 1] ?? null,
    },
  }));
}

const { entry, previous, next } = Astro.props;
---

<Base title={entry.data.title}>
  <span hidden data-day={entry.data.day}></span>
  <Entry entry={entry} />

  <Verdict day={entry.data.day} />

  <nav class="neighbours readout" data-neighbours>
    {previous ? <a href={`/dzien/${previous.data.day}`} rel="prev">&larr; {previous.data.title}</a> : <span />}
    {next ? <a href={`/dzien/${next.data.day}`} rel="next">{next.data.title} &rarr;</a> : <span />}
  </nav>
</Base>

<script>
  import { markRead } from '../../lib/read';
  import { onPage, once } from '../../lib/page';
  import { navigate } from 'astro:transitions/client';

  // Outside the per-page init, and registered once, because the swap replaces
  // the root element's attributes with the incoming document's — which do not
  // include a direction, so the attribute set before navigating is gone by the
  // time the arriving page animates in. Holding it here and putting it back in
  // `astro:after-swap`, which runs before the new page paints, is what makes
  // the second half of the movement go the same way as the first.
  let heading: string | null = null;

  document.addEventListener('astro:after-swap', () => {
    if (heading) document.documentElement.dataset.swipe = heading;
  });

  onPage(() => {
    // Reading it is opening it. A dwell timer would be more accurate and would
    // also mean an entry you opened, read and closed in twenty seconds stays
    // unread — which is the wrong error to make.
    const marker = document.querySelector('[data-day]') as HTMLElement | null;
    if (marker) markRead(Number(marker.dataset.day));

    // Swipe between entries, on touch only.
    //
    // The links are the source of truth — the neighbours are computed at build
    // time and days are not consecutive, so anything that worked out a target
    // from the day number would be wrong at every gap.
    const nav = document.querySelector('[data-neighbours]') as HTMLElement | null;
    if (!nav || !once(nav, 'Swipe') || !window.matchMedia('(pointer: coarse)').matches) return;

    const go = (rel: string) => {
      const link = nav.querySelector(`a[rel="${rel}"]`) as HTMLAnchorElement | null;
      if (!link) return;
      // The direction is set on the root so the stylesheet can slide the old
      // page out the way the thumb went, rather than cross-fading whichever
      // way the navigation happened to come.
      heading = rel === 'next' ? 'forward' : 'back';
      document.documentElement.dataset.swipe = heading;
      navigate(link.href);
    };

    // Cleared once the transition has played out, or the next click on an
    // ordinary link would slide whichever way the last swipe happened to go.
    // Not on `astro:after-swap`, which fires while the transition is still
    // running and would take the direction from the animation using it.
    setTimeout(() => {
      heading = null;
      delete document.documentElement.dataset.swipe;
    }, 500);

    let x = 0;
    let y = 0;
    let at = 0;
    let live = false;

    addEventListener(
      'touchstart',
      (event) => {
        // One finger, and not inside something that scrolls sideways of its
        // own accord — a wide table or a code block gets its own gesture.
        const target = event.target as Element;
        live =
          event.touches.length === 1 && !target.closest('table, pre, [data-scroll-x]');
        if (!live) return;
        x = event.touches[0].clientX;
        y = event.touches[0].clientY;
        at = Date.now();
      },
      { passive: true },
    );

    addEventListener(
      'touchend',
      (event) => {
        if (!live) return;
        live = false;
        const touch = event.changedTouches[0];
        const dx = touch.clientX - x;
        const dy = touch.clientY - y;

        // Deliberate, horizontal, and quick: a slow drag is a scroll that
        // wandered, and a shallow angle is a scroll that wandered further.
        if (Date.now() - at > 700) return;
        if (Math.abs(dx) < 70 || Math.abs(dx) < Math.abs(dy) * 2) return;
        // Someone selecting text is not navigating.
        if (!getSelection()?.isCollapsed) return;

        go(dx < 0 ? 'next' : 'prev');
      },
      { passive: true },
    );
  });
</script>

<style>
  .neighbours {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--ln);
    max-width: var(--measure);
    color: var(--f2);
  }
</style>
