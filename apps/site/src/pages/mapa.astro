---
import Base from '../layouts/Base.astro';
import { loadWorld } from '../lib/world';
import { count } from '../lib/plural';

// The map is built from content/, never from D1 — D1 is a projection of the
// same files, so the site computes the projection itself at build time.
//
// It shows route and sequence and deliberately shows no durations. A map that
// states no times cannot contradict the prose, and the prose is vague about
// travel times on purpose: every figure that enters the canon binds every
// entry after it.
const world = loadWorld();

const name = (id: string) => world.entities.get(id)?.name ?? id.replace(/-/g, ' ');

// Only places. A ship or a person as a stop is an extraction mistake; the state
// guard now rejects one, and this stays because a map of places is what it
// should be regardless.
const isPlace = (id: string) => world.entities.get(id)?.kind === 'place';

// One node per place that a journey has actually touched, in first-touch order.
// That order is the whole spine below, so it is chronology and not a choice.
// Places only ever mentioned are not on the map: this is a record of where he
// has been.
const visited: string[] = [];
for (const hop of world.travel) {
  for (const end of [hop.from, hop.to]) {
    if (end && isPlace(end) && !visited.includes(end)) visited.push(end);
  }
}

// Edges collapse repeats: the same leg flown four times is one line, thicker.
const legs = new Map<string, { from: string; to: string; days: number[] }>();
for (const hop of world.travel) {
  if (!hop.from || !isPlace(hop.from) || !isPlace(hop.to)) continue;
  if (hop.from === hop.to) continue;
  const key = [hop.from, hop.to].sort().join('|');
  const leg = legs.get(key) ?? { from: hop.from, to: hop.to, days: [] };
  leg.days.push(hop.day);
  legs.set(key, leg);
}

const order = new Map(visited.map((id, i) => [id, i]));

// Somewhere he has been that sits inside somewhere else he has been: a moon of
// a world, a station over a planet, a platform on a route. Six of the eighteen
// places are one of these, and the site computed the containment chain and
// threw it away. It is the only genuinely spatial thing the world records, so
// it is the one thing this drawing can show without inventing anything.
const host = new Map<string, string>();
for (const id of visited) {
  const parent = world.entities.get(id)?.parent;
  if (parent && order.has(parent)) host.set(id, parent);
}
const worlds = visited.filter((id) => !host.has(id));

// The layout, computed here rather than in the browser.
//
// What was here before was a spring embedder: four hundred iterations, no
// cooling, constants written when the graph had six nodes and five legs. Its
// clamp box is 620x420, and packing n nodes at the spring's rest length of 150
// needs about n x 19,500 square pixels — so the box held thirteen. At twelve
// nodes ten of them sat exactly on the frame, the middle was empty, and mean
// movement fell to 0.01 while peak velocity *rose* from 5.4 to 10.2. That is
// not a simulation settling; it is nodes pressed against walls that swallow
// their motion, and retuning only moves the failure to a later n.
//
// A spine in visit order replaced it and fixed every legibility defect, and it
// read as a branch diagram: correct about the route and wrong about what the
// route is. This is a chronicle of flying between worlds.
//
// So: worlds scattered on a golden-angle spiral in the order he reached them.
// The angle is 137.5 degrees, which is what leaves no two points on the same
// ray, and the radius grows as the square root of the index, which is what
// keeps the spacing between neighbours constant. Together that gives an
// arrangement that looks strewn rather than plotted and cannot collapse: the
// field grows with the count instead of the count being crushed into a fixed
// field. No seed, no iteration, identical everywhere.
//
// What it must not do is claim distance. The spiral says nothing about how far
// anything is from anything — it is an index turned into an angle — and the
// caption says so, because the world records no coordinates and never will.
const STEP = 105; // spacing between neighbouring worlds
const ORBIT = 30; // how far a moon sits from the world it belongs to
const GOLDEN = Math.PI * (3 - Math.sqrt(5));
const CHAR = 7.3;

const at = new Map<string, { x: number; y: number; moon: boolean }>();
worlds.forEach((id, i) => {
  const angle = i * GOLDEN;
  const radius = STEP * Math.sqrt(i);
  at.set(id, { x: Math.cos(angle) * radius, y: Math.sin(angle) * radius, moon: false });
});
// Moons hang off their world, each at its own angle so two moons of one world
// never land on each other.
const moonIndex = new Map<string, number>();
for (const id of visited) {
  const parent = host.get(id);
  if (!parent) continue;
  const n = moonIndex.get(parent) ?? 0;
  moonIndex.set(parent, n + 1);
  const seat = at.get(parent)!;
  const angle = GOLDEN * (order.get(id) ?? 0) + n * 2.4;
  at.set(id, { x: seat.x + Math.cos(angle) * ORBIT, y: seat.y + Math.sin(angle) * ORBIT, moon: true });
}

const nodes = visited.map((id) => {
  const seat = at.get(id)!;
  const label = name(id);
  // The label goes on whichever side points away from the middle, so names
  // lean outward instead of into the drawing.
  const outward = seat.x >= 0 ? 1 : -1;
  return {
    id,
    name: label,
    visits: world.travel.filter((h) => h.to === id).length,
    step: (order.get(id) ?? 0) + 1,
    ...seat,
    anchor: outward > 0 ? 'start' : 'end',
    lx: seat.x + outward * (seat.moon ? 10 : 13),
    ly: seat.y + 4,
    width: label.length * CHAR,
  };
});

// A greedy nudge, in a fixed order, so two names can never sit on each other.
// With twelve nodes it fires rarely; it is here for the fiftieth.
const placed: { x1: number; x2: number; y: number }[] = [];
for (const n of nodes.slice().sort((a, b) => a.ly - b.ly || a.lx - b.lx)) {
  for (let guard = 0; guard < 24; guard++) {
    const x1 = n.anchor === 'start' ? n.lx : n.lx - n.width;
    const box = { x1, x2: x1 + n.width, y: n.ly };
    const clash = placed.some((p) => Math.abs(p.y - box.y) < 13 && p.x1 < box.x2 + 6 && box.x1 < p.x2 + 6);
    if (!clash) {
      placed.push(box);
      break;
    }
    n.ly += 13;
  }
}

// Routes bow, because a straight line between two stars is a claim and a curve
// is a drawing. The direction of the bow comes from the ids, so it is stable.
const drawn = [...legs.values()]
  .filter((l) => at.has(l.from) && at.has(l.to))
  .map((l) => {
    const p = at.get(l.from)!;
    const q = at.get(l.to)!;
    const dx = q.x - p.x;
    const dy = q.y - p.y;
    const len = Math.hypot(dx, dy) || 1;
    const side = l.from < l.to ? 1 : -1;
    const bow = Math.min(len * 0.16, 34) * side;
    const cx = (p.x + q.x) / 2 - (dy / len) * bow;
    const cy = (p.y + q.y) / 2 + (dx / len) * bow;
    return {
      path: `M ${p.x.toFixed(1)} ${p.y.toFixed(1)} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${q.x.toFixed(1)} ${q.y.toFixed(1)}`,
      days: l.days,
      width: Math.min(1 + l.days.length, 5),
    };
  });

// Moons keep a faint ring on the world they belong to, which is the only mark
// here that means anything physical.
const rings = [...new Set([...host.values()])].map((id) => ({ ...at.get(id)!, r: ORBIT }));

const pad = 30;
const xs = nodes.flatMap((n) => [n.x - 14, n.lx, n.anchor === 'start' ? n.lx + n.width : n.lx - n.width]);
const ys = nodes.flatMap((n) => [n.y - 14, n.y + 14, n.ly + 6]);
const view = {
  x: Math.round(Math.min(...xs) - pad),
  y: Math.round(Math.min(...ys) - pad),
  w: Math.round(Math.max(...xs) - Math.min(...xs) + pad * 2),
  h: Math.round(Math.max(...ys) - Math.min(...ys) + pad * 2),
};

const current = world.travel.length > 0 ? world.travel[world.travel.length - 1].to : null;
---

<Base title="Mapa — ebner.gripe" description="Trasa Ebnera Gripe: miejsca i przeloty, bez czasów.">
  <header class="head">
    <h1>Mapa</h1>
    <p class="readout lead">
      {count(nodes.length, 'miejsce', 'miejsca', 'miejsc')} &middot;
      {count(drawn.length, 'przelot', 'przeloty', 'przelotów')} &middot; bez czasów
    </p>
  </header>

  <figure class="map">
    <div class="frame" data-frame>
      <svg
        data-map
        viewBox={`${view.x} ${view.y} ${view.w} ${view.h}`}
        data-home={`${view.x} ${view.y} ${view.w} ${view.h}`}
        role="img"
        aria-label="Trasa Ebnera: miejsca w kolejności odwiedzenia"
      >
        <g class="rings">
          {rings.map((r) => <circle cx={r.x} cy={r.y} r={r.r} />)}
        </g>
        <g class="legs">
          {
            drawn.map((l) => (
              <path d={l.path} stroke-width={l.width} stroke-linecap="round">
                <title>{`dni: ${l.days.join(', ')}`}</title>
              </path>
            ))
          }
        </g>
        <g class="nodes">
          {
            nodes.map((n) => (
              <a href={`/dni?miejsce=${n.id}`} class={`${n.id === current ? 'here ' : ''}${n.moon ? 'moon' : ''}`}>
                <circle class="hit" cx={n.x} cy={n.y} r={22} />
                <circle
                  class="body"
                  cx={n.x}
                  cy={n.y}
                  r={n.id === current ? 7 : (n.moon ? 3 : 5) + Math.min(n.visits, 2)}
                />
                <text x={n.lx} y={n.ly} text-anchor={n.anchor}>{n.name}</text>
                <title>{`${n.step}. ${n.name}`}</title>
              </a>
            ))
          }
        </g>
      </svg>
    </div>
    <div class="tools readout">
      <button type="button" data-zoom="out" aria-label="Oddal">−</button>
      <button type="button" data-zoom="in" aria-label="Przybliż">+</button>
      <button type="button" data-zoom="home">całość</button>
      <span class="hint">przeciągnij, żeby przesunąć</span>
    </div>
    <figcaption class="readout">
      Duże punkty to światy, małe na pierścieniu — księżyce, stacje i platformy,
      które do nich należą. Linie to przeloty; grubsza znaczy, że tę trasę
      pokonał więcej razy. Rozmieszczenie wynika z kolejności odwiedzin, nie z
      położenia: <strong>ten rysunek nie pokazuje odległości ani czasów</strong>,
      bo współrzędnych w tym świecie nikt nie prowadzi.
    </figcaption>
  </figure>

  <ol class="legend">
    {
      nodes
        .slice()
        .reverse()
        .map((n) => (
          <li class={n.id === current ? 'here' : ''}>
            <span class="place">{n.name}</span>
            <span class="readout meta">
              {n.id === current ? 'tutaj jest teraz' : count(n.visits, 'przylot', 'przyloty', 'przylotów')}
            </span>
          </li>
        ))
    }
  </ol>
</Base>

<script>
  // Only the view moves here. The layout is fixed at build time, so there is
  // nothing to settle and nothing to re-run: this pans and scales the window
  // onto a drawing that is already finished.
  import { onPage, once } from '../lib/page';

  onPage(() => {
    const svg = document.querySelector<SVGSVGElement>('[data-map]');
    const frame = document.querySelector<HTMLElement>('[data-frame]');
    if (!svg || !frame || !once(svg, 'Map')) return;

    const home = (svg.dataset.home ?? '').split(' ').map(Number);
    let [vx, vy, vw, vh] = home;
    const ratio = vh / vw;

    // Kept over the drawing. Without this, panning or opening zoomed near an
    // edge shows a panel half full of nothing — which is what happened on a
    // phone, where the view opens on the current place and the current place
    // is at the rim.
    const hold = () => {
      const [hx, hy, hw, hh] = home;
      vx = vw >= hw ? hx + (hw - vw) / 2 : Math.min(Math.max(vx, hx), hx + hw - vw);
      vy = vh >= hh ? hy + (hh - vh) / 2 : Math.min(Math.max(vy, hy), hy + hh - vh);
    };

    const apply = () => {
      hold();
      svg.setAttribute('viewBox', `${vx} ${vy} ${vw} ${vh}`);
    };

    const scale = (factor: number, cx = vx + vw / 2, cy = vy + vh / 2) => {
      // Clamped so it cannot be zoomed into nothing or out past the drawing by
      // more than a screen — a map you can lose is worse than one that does not
      // move.
      const next = Math.min(Math.max(vw * factor, home[2] / 6), home[2] * 2);
      vx = cx - ((cx - vx) * next) / vw;
      vy = cy - ((cy - vy) * next * ratio) / vh;
      vw = next;
      vh = next * ratio;
      apply();
    };

    // A scatter is wider than a phone, and shrinking it to fit turns
    // twelve-point names into nine. So a narrow screen opens in close, on the
    // place he is now, and pans from there — the whole chart is a button away.
    // A dozen places scattered wide cannot be both wholly visible and readable
    // on a phone: fitting the chart to 390 pixels renders twelve-unit names at
    // seven, which is the defect this page started with. So a narrow screen
    // opens at a readable scale and shows part of the chart.
    //
    // It centres on the middle of the places rather than on where he is now.
    // Centring on the current place was the first try and it opened on an
    // almost empty panel, because the newest world sits at the rim of a spiral
    // that grows outward — the sparsest spot there is. The list below reaches
    // that place in one tap; the map's job here is to show the shape.
    const bodies = [...document.querySelectorAll<SVGCircleElement>('.nodes .body')];
    if (frame.clientWidth < 520 && bodies.length) {
      const mid = (pick: (c: SVGCircleElement) => number) =>
        bodies.reduce((sum, c) => sum + pick(c), 0) / bodies.length;
      const want = Math.min(frame.clientWidth / 0.9, home[2]);
      vw = want;
      vh = want * ratio;
      vx = mid((c) => c.cx.baseVal.value) - vw / 2;
      vy = mid((c) => c.cy.baseVal.value) - vh / 2;
      apply();
    }

    document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((button) => {
      button.addEventListener('click', () => {
        const what = button.dataset.zoom;
        if (what === 'home') {
          [vx, vy, vw, vh] = home;
          apply();
        } else scale(what === 'in' ? 0.7 : 1 / 0.7);
      });
    });

    frame.addEventListener(
      'wheel',
      (event) => {
        // Only with a modifier, so the page still scrolls over the map. A map
        // that eats the scroll wheel is a trap on a long page.
        if (!event.ctrlKey && !event.metaKey) return;
        event.preventDefault();
        scale(event.deltaY > 0 ? 1.12 : 1 / 1.12);
      },
      { passive: false },
    );

    let from: { x: number; y: number } | null = null;
    frame.addEventListener('pointerdown', (event) => {
      if ((event.target as Element).closest('a')) return;
      from = { x: event.clientX, y: event.clientY };
      frame.setPointerCapture(event.pointerId);
      frame.classList.add('dragging');
    });
    frame.addEventListener('pointermove', (event) => {
      if (!from) return;
      const unit = vw / frame.clientWidth;
      vx -= (event.clientX - from.x) * unit;
      vy -= (event.clientY - from.y) * unit;
      from = { x: event.clientX, y: event.clientY };
      apply();
    });
    for (const end of ['pointerup', 'pointercancel']) {
      frame.addEventListener(end, () => {
        from = null;
        frame.classList.remove('dragging');
      });
    }
  });
</script>

<style>
  .head {
    margin-bottom: 24px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 6vw, 44px);
    margin: 0;
  }

  .lead {
    margin: 6px 0 0;
  }

  .map {
    margin: 0;
    background: var(--wb);
    border: 1px solid var(--wl);
  }

  /* The drawing is rendered at its own size rather than stretched to the
     column. Stretching is what made the labels five pixels tall on a phone:
     a 800-unit viewBox in a 333-pixel box scales everything by 0.416, and
     twelve-unit type goes with it. Capped at its natural width, the scale
     stays near 1 at any viewport and the type stays the size it says. */
  .frame {
    overflow: hidden;
    touch-action: pan-y;
  }

  .frame.dragging {
    cursor: grabbing;
  }

  /* The drawing fills the panel. Its own width is set in user units by how
     far apart the worlds sit, not by a cap here — capping a small drawing and
     stretching it is what turned twelve-unit type into five pixels on a phone
     in the version before last. Spread the chart and the scale stays near one
     at the width it is actually shown. */
  .map svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .legs path {
    fill: none;
    stroke: var(--ln);
    opacity: 0.85;
  }

  /* The one mark here that means something physical: what orbits what. */
  .rings circle {
    fill: none;
    stroke: var(--ln);
    stroke-width: 0.75;
    opacity: 0.35;
    stroke-dasharray: 2 4;
  }

  .nodes .body {
    fill: var(--f2);
  }

  .nodes .moon .body {
    fill: var(--f3, var(--f2));
    opacity: 0.85;
  }

  .nodes text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--f2);
    /* A halo in the panel's own colour, so a route passing behind a name
       reads as passing behind it. Scattering the places like stars brings
       back the one defect the spine had removed by construction — `Ambrat`
       was struck through by three edges at once in the version before that —
       and on a chart with crossing lines this is how it is dealt with. */
    paint-order: stroke;
    stroke: var(--wb);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .nodes .moon text {
    font-size: 11px;
    opacity: 0.85;
  }

  .nodes .here .body {
    fill: var(--ac);
  }

  .nodes .here text {
    fill: var(--ac);
  }

  /* An invisible disc far wider than the dot, so a finger has something to
     land on. Twenty-two units clears the forty-four-pixel minimum at the
     scales this renders at. */
  .nodes .hit {
    fill: transparent;
  }

  .nodes a:hover .body,
  .nodes a:focus-visible .body {
    fill: var(--ac);
  }

  .nodes a:hover text,
  .nodes a:focus-visible text {
    fill: var(--fg);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-top: 1px solid var(--wl);
  }

  .tools button {
    min-width: 44px;
    min-height: 32px;
    padding: 0 10px;
    background: transparent;
    border: 1px solid var(--wl);
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .tools button:hover {
    border-color: var(--ac);
    color: var(--ac);
  }

  .tools .hint {
    margin-left: auto;
    opacity: 0.7;
  }

  /* On a phone the hint wraps onto the buttons, and it is telling a touch
     user to do what their finger already does. */
  @media (max-width: 560px) {
    .tools .hint {
      display: none;
    }
  }

  figcaption {
    padding: 12px 14px;
    border-top: 1px solid var(--wl);
    line-height: 1.5;
    text-transform: none;
    letter-spacing: 0;
  }

  .legend {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    max-width: var(--measure);
  }

  .legend li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--sp);
  }

  .legend .place {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .legend .here .place {
    color: var(--ac);
  }
</style>
