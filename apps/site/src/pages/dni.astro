---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { count } from '../lib/plural';
import { loadWorld } from '../lib/world';

const world = loadWorld();
const entries = (await getCollection('entries')).sort((a, b) => b.data.day - a.data.day);

const KIND_LABEL: Record<string, string> = {
  travel: 'podróż',
  new_job: 'nowe zlecenie',
  continuation: 'ciąg dalszy',
  resolution: 'rozstrzygnięcie',
  adventure: 'przygoda',
  quiet: 'cisza',
  note: 'notatka',
  documents: 'dokumenty',
  stopover: 'postój',
};

const placeName = (id: string) => world.entities.get(id)?.name ?? id.replace(/-/g, ' ');

// Days are not consecutive, so the gaps are real and worth showing: a week
// missing usually means the week was the journey.
const rows = entries.map((entry, i) => {
  const next = entries[i + 1];
  return {
    entry,
    gap: next ? entry.data.day - next.data.day : 0,
  };
});

const places = new Set(entries.map((e) => e.data.location));
---

<Base title="Wszystkie dni — ebner.gripe" description="Spis wszystkich dni dziennika roboczego Ebnera Gripe.">
  <header class="head">
    <h1>Wszystkie dni</h1>
    <p class="readout">
      {count(entries.length, 'wpis', 'wpisy', 'wpisów')} &middot;
      {count(places.size, 'miejsce', 'miejsca', 'miejsc')} &middot;
      do dnia {entries[0]?.data.day ?? 0}
    </p>
  </header>

  <ol class="days">
    {
      rows.map(({ entry, gap }) => (
        <li>
          <a href={`/dzien/${entry.data.day}`}>
            <span class="n">{String(entry.data.day).padStart(4, '0')}</span>
            <span class="body">
              <span class="t">{entry.data.title}</span>
              <span class="meta readout">
                {KIND_LABEL[entry.data.kind] ?? entry.data.kind} &middot; {placeName(entry.data.location)}
              </span>
            </span>
          </a>
          {gap > 1 && <p class="gap readout">przerwa {count(gap - 1, 'dnia', 'dni', 'dni')}</p>}
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .head {
    max-width: var(--measure);
    margin-bottom: 32px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 5vw, 40px);
    margin: 0 0 6px;
  }

  .days {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  .days a {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--sp);
  }

  .n {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--wt);
    flex: none;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
  }

  .meta {
    color: var(--ls);
  }

  /* The gap is the point, not a defect — label it rather than hide it. */
  .gap {
    margin: 0;
    padding: 2px 0 2px 62px;
    color: var(--p2);
    font-size: 11px;
  }
</style>
