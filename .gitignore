# Claude Code - personal, machine-local settings
.claude/settings.local.json

# Dependencies
node_modules/

# Astro
apps/site/dist/
apps/site/.astro/

# Wrangler local cache — holds the account id and name, and is regenerated
# wherever wrangler is run from, so it turns up outside apps/site too.
.wrangler/
**/.wrangler/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local environment
.env
.env.local
.env.*.local

# VAPID private key, generated locally and moved to a repository secret
.vapid-private.key

# Playwright MCP scratch output (snapshots, console logs, screenshots),
# written into whatever directory the browser check ran from.
.playwright-mcp/
**/.playwright-mcp/
